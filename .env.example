# Supabase — get from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── App URL (used for redirect URLs) ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email digest (expiring contracts/documents) ─────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=
# Must be on a domain verified in Resend
EMAIL_FROM=
# Shared secret Vercel Cron sends as a Bearer token — generate any random string
CRON_SECRET=
